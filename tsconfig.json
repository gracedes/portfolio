{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "plugins": [
      {
        "name": "@astrojs/ts-plugin"
      },
    ],
    "paths": {
      "@vars": ["./src/vars.ts"],
      "@content/*": ["./src/content.ts"],
      "@images/*": ["./src/images/*"],
      "@components/*": ["./src/components/*"],
    }
  }
}
