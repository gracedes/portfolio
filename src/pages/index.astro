---
import { getCollection } from 'astro:content';
import background from '@images/site-assets/bgtile.png';

import Head from "@components/head/Head.astro";
import Window from "@components/Window.astro";

const { ...props } = Astro.props;
const games = (await getCollection('games')).sort(
	(a, b) => b.data.order - a.data.order
)
---

<html lang="en">
	<head>
		<Head />
	</head>
	<body style={`background-image: url(${background.src})`}>
		<main class="windows">
			{games.map((game) => (
			<Window
				name={game.data.name}
				description={game.data.description}
				image={game.data.image}
				tags={game.data.tags}
				links={game.data.links}
			/>
		))}
		</main>
	</body>
</html>

<style>
	body {
		background-repeat: repeat;
	}

	.windows {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: flex-start;
		gap: 32px;
		padding: 48px 24px;
	}
</style>